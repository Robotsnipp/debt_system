@page
@model DebtSystem.Pages.People.Creditors.DeleteModel
@{
    ViewData["Title"] = "Удалить кредитора";
}

<h2>Удалить кредитора</h2>

<h4>Вы уверены, что хотите удалить этого кредитора?</h4>
<div>
    <p><strong>Имя:</strong> @Model.Creditor?.FullName</p>
    <p><strong>Email:</strong> @Model.Creditor?.Email</p>

    <form method="post">
        <input type="hidden" asp-for="Creditor.Id" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>