@page
@model DebtSystem.Pages.People.Creditors.CreateModel
@{
    ViewData["Title"] = "Добавить кредитора";
}

<h2>Добавить кредитора</h2>

<form method="post">
    <div class="form-group mb-3">
        <label asp-for="Creditor.FirstName" class="form-label">Имя</label>
        <input asp-for="Creditor.FirstName" class="form-control" />
        <span asp-validation-for="Creditor.FirstName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Creditor.LastName" class="form-label">Фамилия</label>
        <input asp-for="Creditor.LastName" class="form-control" />
        <span asp-validation-for="Creditor.LastName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Creditor.Email" class="form-label">Email</label>
        <input asp-for="Creditor.Email" class="form-control" />
        <span asp-validation-for="Creditor.Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Создать</button>
    <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
</form>