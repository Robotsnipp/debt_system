@page
@model DebtSystem.Pages.People.Debtors.CreateModel
@{
    ViewData["Title"] = "Добавить должника";
}

<h2>Добавить должника</h2>

<form method="post">
    <div class="form-group mb-3">
        <label asp-for="Debtor.FirstName" class="form-label">Имя</label>
        <input asp-for="Debtor.FirstName" class="form-control" />
        <span asp-validation-for="Debtor.FirstName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Debtor.LastName" class="form-label">Фамилия</label>
        <input asp-for="Debtor.LastName" class="form-control" />
        <span asp-validation-for="Debtor.LastName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Debtor.Email" class="form-label">Email</label>
        <input asp-for="Debtor.Email" class="form-control" />
        <span asp-validation-for="Debtor.Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Создать</button>
    <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
</form>