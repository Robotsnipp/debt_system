@page
@model DebtSystem.Pages.People.Debtors.DeleteModel
@{
    ViewData["Title"] = "Удалить должника";
}

<h2>Удалить должника</h2>

<h4>Вы уверены, что хотите удалить этого должника?</h4>
<div>
    <p><strong>Имя:</strong> @Model.Debtor?.FullName</p>
    <p><strong>Email:</strong> @Model.Debtor?.Email</p>

    <form method="post">
        <input type="hidden" asp-for="Debtor.Id" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>