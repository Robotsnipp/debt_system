@page
@model DebtSystem.Pages.Debts.IndexModel
@{
    ViewData["Title"] = "Управление долгами";
}

<h2>Список долгов</h2>

<p>
    <a class="btn btn-primary" asp-page="Create">Добавить долг</a>
</p>

@if (Model.DebtList.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Должник</th>
                <th>Кредитор</th>
                <th>Категория</th>
                @* <th>Сумма</th> *@
                <th>Осталось</th>
                <th>Срок</th>
                <th>Штраф</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.DebtList)
            {
                <tr>
                    <td>@d.Debtor?.FullName</td>
                    <td>@d.Creditor?.FullName</td>
                    <td>@d.Category?.Name</td>
                    <td>@d.Amount.ToString("C")</td>
                    @* <td>@d.RemainingAmount.ToString("C")</td> *@
                    <td>@(d.DueDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@(d.CalculatePenalty().ToString("C"))</td>
                    <td>@(d.IsPaid ? "Погашен" : "Активен")</td>
                    <td>
                        <a asp-page="/Receipts/Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-info">Квитанция</a>
                        <a asp-page="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                        <a asp-page="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Нет зарегистрированных долгов.</p>
}